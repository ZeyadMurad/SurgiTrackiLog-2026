# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# REAL EMAIL DELIVERY INFRASTRUCTURE (REQUIRED)
# ==========================================
# SurgiTrack iLog sends verification links DIRECTLY and PRIVATELY to the
# exact registered email address through real SMTP infrastructure.
# Verification URLs and tokens are NEVER exposed in the UI, the API
# response body, or the server logs. Links are governed by strict
# 30-second server-side expiration and single-use security.
#
# Configure ONE of the two options below:
#
# --- Option A: Generic SMTP (recommended for production) ---
# Examples:
#   SendGrid:      SMTP_HOST=smtp.sendgrid.net  SMTP_USER=apikey  SMTP_PASS=<your_sendgrid_key>  SMTP_PORT=587
#   Mailgun:       SMTP_HOST=smtp.mailgun.org   SMTP_USER=postmaster@<your-domain>  SMTP_PASS=<password>  SMTP_PORT=587
#   Amazon SES:    SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_USER=<smtp-username>  SMTP_PASS=<smtp-password>  SMTP_PORT=587
#   Zoho Mail:     SMTP_HOST=smtp.zoho.com  SMTP_PORT=587
#   Office365:     SMTP_HOST=smtp.office365.com  SMTP_PORT=587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Sender address used in the "From:" header. Must be authorized by your SMTP provider.
SMTP_FROM="\"SurgiTrack Verification\" <security@surgitrack.app>"
#
# --- Option B: Gmail convenience (dev / low volume only) ---
# Use an App Password (https://myaccount.google.com/apppasswords), NOT your account password.
# SMTP_PROVIDER="gmail"
# SMTP_USER="your.gmail.account@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="\"SurgiTrack Verification\" <your.gmail.account@gmail.com>"
SMTP_PROVIDER=""
