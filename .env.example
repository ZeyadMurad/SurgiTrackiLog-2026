# ================================================================
# SurgiTrack iLog — Environment Variables Template
# ================================================================
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored and NEVER committed to the repository.
#
# For production deployment, set the same variables in your hosting
# platform's secrets panel (Vercel / Cloud Run / Netlify / AI Studio).
# ================================================================

# ===== FIREBASE CONFIG =====
# Real Firebase project credentials. Read by Vite and exposed to the
# client via `import.meta.env.VITE_FIREBASE_*`. These are NOT secrets in
# the traditional sense (Firebase web API keys are designed to be public),
# but storing them in env vars keeps the repo deployable across multiple
# environments (dev / staging / prod) without code changes.
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# ===== GEMINI AI (server-side) =====
# Required for the AI recommendation letter generator and the medical
# assistant. In AI Studio this is injected automatically from the
# Secrets panel.
GEMINI_API_KEY=""

# ===== APP URL (server-side) =====
# The public URL where the app is hosted. Used to compose self-referential
# links (verification callbacks, OAuth redirects). In AI Studio this is
# injected automatically with the Cloud Run service URL.
APP_URL=""

# ===== SMTP EMAIL DELIVERY (server-side) =====
# REQUIRED for real email verification. Verification links are sent
# directly and privately to the user's registered email through real
# SMTP infrastructure — they are NEVER displayed in the UI, NEVER
# returned in API responses, and NEVER written to server logs.
#
# Configure ONE of the two options below:
#
# --- Option A: Generic SMTP (recommended for production) ---
# Examples:
#   SendGrid:      SMTP_HOST=smtp.sendgrid.net  SMTP_USER=apikey  SMTP_PASS=<your_sendgrid_key>  SMTP_PORT=587
#   Mailgun:       SMTP_HOST=smtp.mailgun.org   SMTP_USER=postmaster@<your-domain>  SMTP_PASS=<password>  SMTP_PORT=587
#   Amazon SES:    SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_USER=<smtp-username>  SMTP_PASS=<smtp-password>  SMTP_PORT=587
#   Zoho Mail:     SMTP_HOST=smtp.zoho.com  SMTP_PORT=587
#   Office365:     SMTP_HOST=smtp.office365.com  SMTP_PORT=587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Sender address used in the "From:" header. Must be authorized by your SMTP provider.
SMTP_FROM="\"SurgiTrack Verification\" <security@surgitrack.app>"
#
# --- Option B: Gmail convenience (dev / low volume only) ---
# Use an App Password (https://myaccount.google.com/apppasswords), NOT your account password.
# SMTP_PROVIDER="gmail"
# SMTP_USER="your.gmail.account@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="\"SurgiTrack Verification\" <your.gmail.account@gmail.com>"
SMTP_PROVIDER=""
