# ================================================================
# SurgiTrack iLog — Environment Variables Template
# ================================================================
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored and NEVER committed to the repository.
#
# For production deployment, set the same variables in your hosting
# platform's secrets panel (Vercel / Cloud Run / Netlify / AI Studio).
# ================================================================

# ===== FIREBASE CONFIG =====
# Real Firebase project credentials. Read by Vite and exposed to the
# client via `import.meta.env.VITE_FIREBASE_*`. These are NOT secrets in
# the traditional sense (Firebase web API keys are designed to be public),
# but storing them in env vars keeps the repo deployable across multiple
# environments (dev / staging / prod) without code changes.
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# ===== GEMINI AI (server-side) =====
# Required for the AI recommendation letter generator and the medical
# assistant. In AI Studio this is injected automatically from the
# Secrets panel.
GEMINI_API_KEY=""

# ===== APP URL (server-side) =====
# The public URL where the app is hosted. Used to compose self-referential
# links (verification callbacks, OAuth redirects). In AI Studio this is
# injected automatically with the Cloud Run service URL.
APP_URL=""

# ===== EMAIL DELIVERY =====
# Verification links are sent directly and privately to the user's registered
# email. They are NEVER displayed in the UI, NEVER returned in API responses,
# and NEVER written to server logs.
#
# THREE DELIVERY MODES (priority order):
#
# --- Option A: Brevo HTTP API (RECOMMENDED — sends to ANY recipient) ---
# Works on Render free tier (uses HTTPS, not blocked). Free tier: 300 emails/day.
# 1. Sign up at https://www.brevo.com (free, no credit card)
# 2. Verify your account email when Brevo sends you the activation link
# 3. Go to SMTP & API → API Keys → Generate new key (starts with xkeysib-)
# 4. Set BREVO_API_KEY below
# 5. Set SMTP_FROM to your Brevo account email:
#    "SurgiTrack Verification" <your-brevo-account@email.com>
BREVO_API_KEY=""
#
# --- Option B: Resend HTTP API (free tier sends ONLY to account owner's email) ---
# Also works on Render free tier (HTTPS). Free tier: 3000 emails/month, BUT
# without a verified domain you can only send to your OWN Resend account email.
# To send to all recipients, verify a domain at https://resend.com/domains
# 1. Sign up at https://resend.com (free, no credit card)
# 2. Copy your API key from the dashboard
# 3. Set RESEND_API_KEY below
# 4. For the free tier (no domain verified), set SMTP_FROM to:
#    "SurgiTrack Verification" <onboarding@resend.dev>
RESEND_API_KEY=""
#
# --- Option C: SMTP (for local dev, paid Render, Vercel, Cloud Run) ---
# Does NOT work on Render free tier (SMTP ports 25/465/587 are blocked).
# Configure ONE of:
#   Generic SMTP: SMTP_HOST + SMTP_PORT + SMTP_USER + SMTP_PASS
#   Gmail:        SMTP_PROVIDER=gmail + SMTP_USER + SMTP_PASS (App Password)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_PROVIDER=""
#
# Sender address (used by all delivery modes).
# For Brevo: your Brevo account email (or a Brevo-verified domain)
# For Resend free tier: onboarding@resend.dev
# For Resend with verified domain: noreply@surgitrack.com
SMTP_FROM="\"SurgiTrack Verification\" <noreply@surgitrack.com>"
